{
  "name": "rha-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite",
    "dev:api": "VITE_ENABLE_MOCKS=false vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.mjs\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.mjs\" \"*.ts\"",
    "generate:api": "orval"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@vitejs/plugin-react": "latest",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "msw": "^3.0.3",
    "next-themes": "^0.4.6",
    "pretendard": "^1.3.9",
    "radix-ui": "^1.8.1",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "^7.90.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "msw": "^3.0.3",
    "orval": "^8.41.0",
    "prettier": "^3.9.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
